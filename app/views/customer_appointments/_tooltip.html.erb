<h3>
  <%= link_to appointment.subject,
              customer_appointment_path(appointment) %>
</h3>

<p class="subtitle">
  <strong><%= appointment.status.to_s.humanize %></strong>
</p>

<table class="attributes">

  <% if appointment.date %>
    <tr>
      <th><%= l(:label_time) %></th>
      <td><%= appointment.date.strftime('%I:%M %p') %></td>
    </tr>
  <% end %>

  <% if appointment.customer %>
    <tr>
      <th><%= l(:label_customer) %></th>
      <td><%= link_to appointment.customer %></td>
    </tr>
  <% end %>

  <% if appointment.vehicle %>
    <tr>
      <th><%= l(:label_vehicle) %></th>
      <td><%= link_to appointment.vehicle %></td>
    </tr>
  <% end %>

  <% if appointment.user %>
    <tr>
      <th><%= l(:label_technician) %></th>
      <td>
        <%= avatar(appointment.user, size: 16) %>
        <%= link_to appointment.user %>
      </td>
    </tr>
  <% end %>

  <% if appointment.project %>
    <tr>
      <th><%= l(:label_project) %></th>
      <td><%= link_to_project appointment.project %></td>
    </tr>
  <% end %>

  <% if appointment.estimate %>
    <tr>
      <th><%= l(:label_estimate) %></th>
      <td>
        <%= link_to appointment.estimate %>
      </td>
    </tr>
  <% end %>

  <tr>
    <th><%= l(:label_start_date) %></th>
    <td><%= format_date(appointment.start_date) %></td>
  </tr>

  <% if appointment.duration > 1 %>
    <tr>
      <th><%= l(:label_end_date) %></th>
      <td><%= format_date(appointment.due_date ) %></td>
    </tr>
  <% end %>

  <tr>
    <th><%= l(:label_estimated_hours) %></th>
    <td><%= number_with_precision(appointment.estimated_hours, precision: 1) %> hrs</td>
  </tr>

  <tr>
    <th><%= l(:label_duration) %></th>
    <td><%= number_with_precision(appointment.duration, precision: 1) %> days</td>
  </tr>

</table>

<% if appointment.description.present? %>

  <hr>

  <div class="description">
    <%= textilizable(appointment.description) rescue simple_format(h(appointment.description)) %>
  </div>

<% end %>

<hr>

<p class="buttons">
  <%= link_to l(:label_open_appointment), customer_appointment_path(appointment), class: "icon icon-edit" %>
</p>