<table class="list">

<thead>

<tr>

<th><%= l(:label_customer) %></th>

<% if CustomerAppointment.vehicles? %><th><%= l(:label_vehicle) %></th><% end %>

<th><%= l(:label_appointment) %></th>

<th><%= l(:label_user) %></th>

<th><%= l(:label_date) %></th>

<th><%= l(:label_status) %></th>

</tr>

</thead>

<tbody>

<% appointments.each do |appointment| %>

<tr>

<td>

<%= link_to appointment.customer unless appointment.customer.nil? %>

</td>

<% if CustomerAppointment.vehicles? %>
<td>

<%= link_to appointment.vehicle unless appointment.vehicle.nil? %>

</td>
<% end %>

<td>

<%= link_to appointment %>

</td>

<td>

<%= link_to appointment.user unless appointment.user.nil? %>

</td>

<td>

<%= format_date(
      appointment.date
    ) %>

</td>

<td>

<%= appointment_status_badge(appointment) %>

</td>

</tr>

<% end %>

</tbody>

</table>