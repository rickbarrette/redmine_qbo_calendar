<table class="list">

<thead>

<tr>

<th><%= l(:label_customer) %></th>

<%= call_hook(:view_customer_appointments_list_header, list: :index) %>

<th><%= l(:label_appointment) %></th>

<th><%= l(:label_user) %></th>

<th><%= l(:label_date) %></th>

<th><%= l(:label_status) %></th>

</tr>

</thead>

<tbody>

<% appointments.each do |appointment| %>

<tr>

<td>

<%= link_to appointment.customer unless appointment.customer.nil? %>

</td>

<%= call_hook(:view_customer_appointments_list_row, list: :index, appointment: appointment) %>

<td>

<%= link_to appointment %>

</td>

<td>

<%= link_to appointment.user unless appointment.user.nil? %>

</td>

<td>

<%= format_date(
      appointment.date
    ) %>

</td>

<td>

<%= appointment_status_badge(appointment) %>

</td>

</tr>

<% end %>

</tbody>

</table>