<%
  # Which working day of the appointment this is (the calendar passes it; weekends and holidays skipped)
  duration = [appointment.duration.to_i, 1].max
  day_number = local_assigns[:day_number] || appointment.working_day_number(day).to_i
%>

<%
  status = appointment.status_record
  css = ['appointment-block', 'tooltip', (appointment.call_out? ? 'call-out' : status.key.parameterize), ('no-hours' if status && !status.counts_hours?)]
%>
<%= tag.div class: css.compact, style: status&.style do %>

  <div class="appointment-bar"></div>

  <div class="appointment-card">

    <%# Row 1: Avatar | Title %>
    <div class="appointment-header">
      <% if appointment.user %>
        <%= avatar(appointment.user, size: 25, class: "appointment-avatar") %>
      <% end %>

      <span class="appointment-title">
        <%= link_to(appointment.subject, customer_appointment_path(appointment), class: "appointment-link") %>
      </span>
    </div>

    <hr class="appointment-divider" />

    <%# Row 2: Time | Day Count | Hours %>
    <div class="appointment-meta">
      <span class="appointment-time">
        <%= appointment.date.strftime('%I:%M %p') if appointment.date.present? %>
      </span>

      <% if duration > 1 && day_number.positive? && day_number <= duration %>
       <span class="appointment-days">(Day <%= day_number %> of <%= duration %>)</span>
      <% end %>

      <%# Call-outs don't use hours %>
      <% if appointment.call_out? %>
        <span class="appointment-call-out-label" title="<%= l(:label_call_out) %>"><i class="fa-solid fa-user-slash"></i></span>
      <% else %>
        <span class="appointment-hours">
          <%= number_with_precision(appointment.estimated_hours.to_f, precision: 1) %>h
        </span>
      <% end %>
    </div>

    <%# Row 3: Details %>
    <% if appointment.customer %>
      <hr class="appointment-divider" />
      <div class="appointment-detail">
        <%= appointment.customer.name %>
        <% if appointment.vehicle %>
          <br/> <%= appointment.vehicle.name %>
        <% end %>
      </div>
    <% end %>

  </div>

  <span class="tip">
    <%= render partial: "customer_appointments/tooltip", locals: { appointment: appointment, day: day } %>
  </span>

<% end %>