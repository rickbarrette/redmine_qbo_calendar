<%= javascript_include_tag("customer-modal", plugin: :redmine_qbo_calendar) %>

<%= labelled_form_for @appointment do |f| %>
  <%= error_messages_for @appointment %>

  <div class="box tabular">
    <%= f.hidden_field :event_type %>
  <% if @appointment.call_out? %>
    <%# An employee off work: no customer, vehicle, estimate, hours or status %>
    <p>
      <label for="customer_appointment_user_id"><%= l(:label_employee) %> <span class="required">*</span></label>
      <%= f.collection_select :user_id, User.active.sorted, :id, :name, { include_blank: true }, { label: false } %>
    </p>

    <p>
      <%= f.text_field :subject, style: "width: 95%;", placeholder: l(:text_call_out_subject_placeholder) %>
    </p>

    <p><%= f.datetime_local_field :date %></p>
    <p><%= f.number_field :duration, step: 1, size: 6, label: :label_duration %></p>
  <% else %>
    <p><%= f.text_field :subject, required: true, style: "width: 95%;" %></p>

    <p>
      <%= f.text_field :customer, label: :label_customer, class: "customer-name", autocomplete: "off", data: { autocomplete_url: "/customers/autocomplete" } %>
      <%= f.hidden_field :customer_id, id: "customer_id" %>
      <%# Creates the customer in a dialog without leaving the appointment (customer-modal.js), for users who
          may add customers %>
      <% if User.current.allowed_to?(:add_customers, nil, global: true) %>
        <%= link_to sprite_icon('add', l(:label_new_customer)), '#', id: 'inline-create-customer-btn',
                    class: 'icon icon-add', title: l(:label_new_customer) %>
      <% end %>
    </p>

    <p>
      <%= f.label :vehicle_id, l(:label_vehicle) %>
      <%= f.collection_select :vehicle_id, @appointment.customer&.vehicles || [], :id, :name, { include_blank: true }, { label: false, id: "appointment_vehicle_id" } %>
    </p>

    <p>
      <%= f.label :estimate_id, l(:label_estimate) %>
      <%= f.collection_select :estimate_id, @appointment.customer&.estimates || [], :id, :name, { include_blank: true }, { label: false, id: "appointment_estimate_id" } %>
    </p>

    <p>
      <%= f.label :user_id, l(:field_user) %>
      <%= f.collection_select :user_id, User.active.sorted, :id, :name, { include_blank: true }, { label: false } %>
    </p>

    <p><%= f.datetime_local_field :date %></p>

    <p><%= f.number_field :estimated_hours, step: 1, size: 6 %></p>
    <p><%= f.number_field :duration, step: 1, size: 6, label: :label_duration %></p>

    <%# The statuses set up in the plugin settings, plus a removed one this appointment still has %>
    <% status_options = CustomerAppointment.status_options %>
    <% status_options += [[@appointment.status_record.name, @appointment.status]] if @appointment.status.present? && !@appointment.status_record.known? %>
    <p><%= f.select :status, status_options, label: :field_status %></p>
  <% end %>

    <p>
      <%= f.text_area :description,
                      rows: 8,
                      class: 'wiki-edit',
                      style: 'width: 95%;',
                      id: 'customer_appointment_description' %>
      <%= wikitoolbar_for 'customer_appointment_description' %>
    </p>
  </div>

  <%= submit_tag l(:button_save) %>
<% end %>

<%# When an estimate is picked, the hours are raised to at least its labor hours %>
<%= javascript_tag do %>
  $(function () {
    var $estimate = $('#appointment_estimate_id');
    var $hours = $('#customer_appointment_estimated_hours');
    if (!$estimate.length || !$hours.length) return;
    $estimate.on('change', function () {
      if (!this.value) return;
      $.getJSON('<%= j estimate_hours_customer_appointments_path %>', { estimate_id: this.value }).done(function (data) {
        var hours = parseInt(data.hours, 10) || 0;
        if (hours > (parseInt($hours.val(), 10) || 0)) $hours.val(hours);
      });
    });
  });
<% end %>

<!-- Modal Container for Inline Customer Creation -->
<div id="new-customer-dialog" style="display:none;" title="<%= t(:label_new_customer, default: 'New Customer') %>">
  <!-- The form will be dynamically loaded via JS or rendered here -->
</div>