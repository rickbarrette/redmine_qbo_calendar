<%= labelled_form_for @appointment do |f| %>
  <%= error_messages_for @appointment %>

  <div class="box tabular">
    <p><%= f.text_field :subject, required: true, style: "width: 95%;" %></p>

    <p>
      <%= f.text_field :customer, label: :label_customer, class: "customer-name", autocomplete: "off", data: { autocomplete_url: "/customers/autocomplete" } %>
      <%= f.hidden_field :customer_id, id: "customer_id", onchange: "this.form.requestSubmit()" %>
    </p>

    <p>
      <%= f.label :vehicle_id, l(:label_vehicle) %>
      <%= f.collection_select :vehicle_id, @appointment.customer&.vehicles || [], :id, :name, { include_blank: true }, { label: false } %>
    </p>

    <p>
      <%= f.label :estimate_id, l(:label_estimate) %>
      <%= f.collection_select :estimate_id, @appointment.customer&.estimates || [], :id, :name, { include_blank: true }, { label: false } %>
    </p>

    <p>
      <%= f.label :user_id, l(:field_user) %>
      <%= f.collection_select :user_id, User.active.sorted, :id, :name, { include_blank: true }, { label: false } %>
    </p>

    <p><%= f.date_field :start_date, size: 10 %></p>
    <p><%= f.date_field :end_date, size: 10 %></p>

    <p><%= f.number_field :estimated_hours, step: 0.1, size: 6 %></p>
    <p><%= f.number_field :duration, step: 1, size: 6, label: :label_duration %></p>

    <p><%= f.select :status, CustomerAppointment::STATUSES, label: :field_status %></p>

    <p>
      <%= f.text_area :description, rows: 8, class: 'wiki-edit', style: 'width: 95%;' %>
      <%= wikitoolbar_for 'appointment_description' %>
    </p>
  </div>

  <%= submit_tag l(:button_save) %>
<% end %>