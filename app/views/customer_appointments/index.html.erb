<h2><%= l(:title_customer_appointments) %></h2>

<div class="contextual">
  <%= link_to issues_calendar_path do %>
    <i class="fa-regular fa-calendar-days"></i> <%= l(:button_calendar) %>
  <% end %>

  <%= link_to new_customer_appointment_path do %>
    <i class="fa-regular fa-pen-to-square"></i> <%= l(:button_add) %>
  <% end %>

</div>

<table class="list">

<thead>

<tr>

<th><%= l(:label_customer) %></th>

<th><%= l(:label_vehicle) %></th>

<th><%= l(:label_appointment) %></th>

<th><%= l(:label_user) %></th>

<th><%= l(:label_date) %></th>

<th><%= l(:label_status) %></th>

</tr>

</thead>

<tbody>

<% @appointments.each do |appointment| %>

<tr>

<td>

<%= link_to appointment.customer unless appointment.customer.nil? %>

</td>

<td>

<%= link_to appointment.vehicle unless appointment.vehicle.nil? %>

</td>

<td>

<%= link_to appointment %>

</td>

<td>

<%= link_to appointment.user unless appointment.user.nil? %>

</td>

<td>

<%= format_date(
      appointment.date
    ) %>

</td>

<td>

<%= appointment.status %>

</td>

</tr>

<% end %>

</tbody>

</table>