<h2><%= l(:title_customer_appointments) %></h2>

<div class="contextual">
  <%= link_to issues_calendar_path do %>
    <i class="fa-regular fa-calendar-days"></i> <%= l(:button_calendar) %>
  <% end %>

  <% if User.current.allowed_to?(:add_customer_appointments, nil, global: true) %>
    <%= link_to new_customer_appointment_path do %>
      <i class="fa-regular fa-pen-to-square"></i> <%= l(:button_add) %>
    <% end %>
  <% end %>

</div>

<%= render partial: "list", locals: { appointments: @appointments } %>